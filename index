    .tech-border::before, .tech-border::after { content: ''; position: absolute; width: 10px; height: 10px; border-color: #22d3ee; transition: all .3s ease; }
    .tech-border::before { top: -1px; left: -1px; border-top: 2px solid; border-left: 2px solid; }
    .tech-border::after { bottom: -1px; right: -1px; border-bottom: 2px solid; border-right: 2px solid; }
    .tech-border:hover::before, .tech-border:hover::after { width: 15px; height: 15px; filter: drop-shadow(0 0 4px #22d3ee); }

